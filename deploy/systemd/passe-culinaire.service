[Unit]
Description=Passe Culinaire web application
After=network.target postgresql.service

[Service]
Type=simple
User=passe
Group=passe
WorkingDirectory=/srv/passe-culinaire/current
EnvironmentFile=/etc/passe-culinaire.env
Environment=NODE_ENV=production
Environment=RUN_JOBS=false
Environment=READINESS_FILE=/run/passe-culinaire/ready
RuntimeDirectory=passe-culinaire
RuntimeDirectoryMode=0755
ExecStartPre=/usr/bin/rm -f /run/passe-culinaire/ready
ExecStart=/srv/passe-culinaire/node/bin/node node_modules/next/dist/bin/next start --hostname 127.0.0.1
ExecStartPost=/srv/passe-culinaire/node/bin/node scripts/warm-release.mjs
ExecStopPost=/usr/bin/rm -f /run/passe-culinaire/ready
TimeoutStartSec=240
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
KillMode=control-group
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
