[Unit]
Description=Run due Passe Culinaire publication jobs
After=passe-culinaire.service

[Service]
Type=oneshot
User=passe
Group=passe
WorkingDirectory=/srv/passe-culinaire/current
EnvironmentFile=/etc/passe-culinaire.env
ExecStart=/srv/passe-culinaire/node/bin/node scripts/run-jobs.mjs
TimeoutStartSec=50
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
