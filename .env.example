# Application PostgreSQL 16 database URL.
DATABASE_URI=postgresql://USER:PASSWORD@127.0.0.1:5432/passe_culinaire
# Separate local PostgreSQL 16 test database URL; pnpm test resets its public schema.
TEST_DATABASE_URI=postgresql://USER:PASSWORD@127.0.0.1:5432/passe_culinaire_test
# Private signing secret for Payload authentication.
PAYLOAD_SECRET=replace-with-a-unique-random-secret
# Separate private bearer secret for publication invalidation.
REVALIDATE_SECRET=replace-with-another-unique-random-secret
# Canonical public origin, HTTPS in production.
NEXT_PUBLIC_SERVER_URL=http://localhost:3000
# Rob's initial admin email for the seed.
ROB_ADMIN_EMAIL=rob@example.test
# Rob's initial admin password for the seed.
ROB_ADMIN_PASSWORD=replace-with-a-private-password
# Alex's initial admin email for the seed.
ALEX_ADMIN_EMAIL=alex@example.test
# Alex's initial admin password for the seed.
ALEX_ADMIN_PASSWORD=replace-with-a-different-private-password
# Media backend, local or s3.
MEDIA_STORAGE=local
# Local upload directory when MEDIA_STORAGE is local.
MEDIA_DIR=./media
# S3 bucket name when MEDIA_STORAGE is s3.
# S3_BUCKET=replace-me
# S3 region when MEDIA_STORAGE is s3.
# S3_REGION=ap-southeast-2
# Optional S3-compatible endpoint.
# S3_ENDPOINT=https://s3.example.test
# Enable path-style addressing for a compatible S3 endpoint.
# S3_FORCE_PATH_STYLE=false
# S3 access key when static credentials are used.
# S3_ACCESS_KEY_ID=replace-me
# S3 secret key when static credentials are used.
# S3_SECRET_ACCESS_KEY=replace-me
# Crawler-accessible HTTPS base URL for stored S3 media.
# S3_PUBLIC_BASE_URL=https://media.example.test
# Outbound mail provider, smtp or resend.
MAIL_PROVIDER=smtp
# From address for contact notification.
MAIL_FROM_ADDRESS=noreply@example.test
# One or two comma-separated notification inboxes (Rob and Alex). Blank saves enquiries without email.
CONTACT_TO_ADDRESS=
# SMTP server hostname when using smtp.
# SMTP_HOST=
# SMTP server port when using smtp.
# SMTP_PORT=587
# Use TLS immediately for SMTP when true.
# SMTP_SECURE=false
# SMTP authentication username when required.
# SMTP_USER=
# SMTP authentication password when required.
# SMTP_PASSWORD=
# Resend API key when using resend.
# RESEND_API_KEY=
# Embedded worker alternative; keep false when using the recommended systemd jobs timer.
RUN_JOBS=false
# false locally, true only behind Caddy on loopback, render only on Render.
TRUST_PROXY=false
# Loopback Next server port, also supplied to the Caddy service.
PORT=3000
# Public Caddy site address; supply these Caddy values through its separate service environment.
# SITE_ADDRESS=passeculinaire.com
# Absolute checkout path read by Caddy for static error pages and licensed fonts.
# APP_ROOT=/var/www/passe-culinaire
# Caddy's local administrative listener used for graceful configuration reloads.
# CADDY_ADMIN=localhost:2019
# Optional IndexNow verification key (8–128 letters, digits or hyphens); blank disables notifications.
INDEXNOW_KEY=

# Required private bearer secret for the recommended POST /api/jobs/run systemd timer.
CRON_SECRET=

# Absolute directory for matched database/media backups (local storage only).
# BACKUP_DIR=/var/backups/passe-culinaire
# Keep completed backups for this many days, after a new successful backup.
BACKUP_RETENTION_DAYS=14
# Deployed Git revision included in backup manifests; set per release.
# RELEASE_ID=replace-with-git-revision
# Set only by the backup wrapper after stopping all application writers.
# BACKUP_WRITES_PAUSED=true
# Optional local Caddy binary for performance tests; defaults to PATH or .local/bin/caddy.
# CADDY_BIN=/usr/bin/caddy
# Restore original 120kB JavaScript and <2s LCP targets instead of approved exception ceilings.
QUALITY_STRICT_BUDGETS=false
# Optional Next output directory for isolated test builds; ordinary releases use .next.
# NEXT_DIST_DIR=.next-quality
# Runtime mode is set to production by the service; leave unset in local development.
# NODE_ENV=production
# No analytics provider is integrated. External embeds are disabled by default in Site Settings.

# Written by warm-release only after successful invalidation and route checks; set by systemd.
# READINESS_FILE=/run/passe-culinaire/ready
# Caddy's matching readiness directory; passed through its separate service environment.
# READINESS_DIR=/run/passe-culinaire
