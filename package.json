{
  "name": "passe-culinaire",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0 <23"
  },
  "packageManager": "pnpm@11.1.3",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint src tests scripts *.mjs *.cjs vitest.config.ts playwright.config.ts --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "pretest": "tsx scripts/prepare-test-db.ts",
    "test": "vitest run",
    "payload": "payload",
    "migrate": "payload migrate",
    "migrate:create": "payload migrate:create",
    "seed": "tsx scripts/seed.ts",
    "jobs:run": "node --env-file-if-exists=.env scripts/run-jobs.mjs",
    "test:e2e": "node scripts/run-quality.mjs e2e",
    "test:performance": "node scripts/run-quality.mjs performance",
    "film:preview": "node docs/designs/kitchen-animation/cinema/serve-preview.mjs",
    "film:studio": "remotion studio docs/designs/kitchen-animation/remotion-film/index.ts --public-dir docs/designs/kitchen-animation/remotion-film/public --port 4183 --no-open",
    "film:render": "node docs/designs/kitchen-animation/remotion-film/render.mjs",
    "film:render:mobile": "node docs/designs/kitchen-animation/remotion-film/render.mjs --mobile"
  },
  "dependencies": {
    "@payloadcms/db-postgres": "3.90.2",
    "@payloadcms/email-nodemailer": "3.90.2",
    "@payloadcms/email-resend": "3.90.2",
    "@payloadcms/live-preview-react": "3.90.2",
    "@payloadcms/next": "3.90.2",
    "@payloadcms/richtext-lexical": "3.90.2",
    "@payloadcms/storage-s3": "3.90.2",
    "@payloadcms/ui": "3.90.2",
    "graphql": "16.11.0",
    "next": "16.3.6",
    "payload": "3.90.2",
    "pg": "8.20.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sharp": "0.35.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@lhci/cli": "0.15.1",
    "@playwright/test": "1.63.0",
    "@remotion/bundler": "4.0.529",
    "@remotion/cli": "4.0.529",
    "@remotion/renderer": "4.0.529",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.19.15",
    "@types/pg": "8.20.0",
    "@types/react": "19.2.16",
    "@types/react-dom": "19.2.3",
    "esbuild": "0.28.2",
    "eslint": "9.39.3",
    "eslint-config-next": "16.3.6",
    "remotion": "4.0.529",
    "tailwindcss": "4.3.3",
    "tsx": "4.22.4",
    "typescript": "5.9.3",
    "vitest": "5.0.1"
  }
}
